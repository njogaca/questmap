# Copia este archivo a .env:  Copy-Item .env.example .env

# Credenciales de Postgres (solo locales)
POSTGRES_USER=questmap
POSTGRES_PASSWORD=questmap
POSTGRES_DB=questmap

# URL para conectarte desde el PC (fuera de Docker). Dentro de Docker,
# docker-compose.yml la sobrescribe para apuntar al servicio "db".
DATABASE_URL=postgres://questmap:questmap@localhost:5433/questmap

# Zona horaria IANA para calcular "hoy" (racha, Daily Quest, study_log).
# Atlanta, Georgia = America/New_York
TZ=America/New_York

# Claude (opcional). Sin API key = Modo A (copiar/pegar prompts en claude.ai, costo $0).
# Con API key + modelo = Modo B (todo dentro de la app). La clave nunca llega al navegador.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
MAX_API_CALLS_PER_DAY=50
